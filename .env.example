# Copie para .env.local e ajuste. O arquivo .env.local não deve ser compartilhado.
# Conta administradora única: usada só para o painel de contas de acesso.
# Para trocar a senha, edite ADMIN_PASSWORD (mínimo 8 caracteres) e reinicie o servidor.
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
DATABASE_PATH=./data/proz-saude.sqlite
UPLOADS_PATH=./uploads
# Prisma CLI usa este URL; o app deriva o URL de DATABASE_PATH.
DATABASE_URL=file:../data/proz-saude.sqlite
