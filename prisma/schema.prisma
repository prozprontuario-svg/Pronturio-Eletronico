generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id
  email        String           @unique
  name         String
  role         String
  passwordHash String           @map("password_hash")
  active       Int              @default(1)
  createdAt    String           @map("created_at")
  sessions     Session[]
  records      ClinicalRecord[]

  @@map("users")
}

model Session {
  tokenHash String @id @map("token_hash")
  userId    String @map("user_id")
  expiresAt String @map("expires_at")
  user      User   @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model Patient {
  id        String           @id
  chart     String           @unique
  name      String
  birth     String
  sex       String
  mother    String           @default("")
  father    String           @default("")
  document  String           @default("")
  phone     String           @default("")
  zip       String           @default("")
  address   String           @default("")
  city      String           @default("")
  status    String           @default("Internada")
  ward      String           @default("")
  bed       String           @default("")
  admission String           @default("")
  allergies String           @default("")
  risks     String           @default("")
  createdAt String           @map("created_at")
  records   ClinicalRecord[]

  @@map("patients")
}

model ClinicalRecord {
  id        String  @id
  patientId String  @map("patient_id")
  type      String
  data      String
  status    String  @default("confirmed")
  authorId  String  @map("author_id")
  createdAt String  @map("created_at")
  updatedAt String  @map("updated_at")
  patient   Patient @relation(fields: [patientId], references: [id])
  author    User    @relation(fields: [authorId], references: [id])

  @@index([patientId, type, createdAt], map: "records_patient_type")
  @@map("records")
}

model Audit {
  id       String @id
  userId   String @map("user_id")
  action   String
  entity   String
  recordId String @map("record_id")
  at       String

  @@map("audit")
}
